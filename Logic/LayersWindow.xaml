<Window x:Class="FeatherCAD.LayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire de Calques" Height="350" Width="450" 
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="LayersGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible}"/>
                <DataGridCheckBoxColumn Header="Verr." Binding="{Binding IsLocked}"/>
                <DataGridTemplateColumn Header="Actif" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Liaison directe sur IsActiveLayer du calque -->
                            <RadioButton IsChecked="{Binding IsActiveLayer, UpdateSourceTrigger=PropertyChanged}" 
                         GroupName="ActiveLayerGroup" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"
                         Click="ActivateLayer_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Ajouter" Width="80" Click="AddLayer_Click" Margin="5,0"/>
            <Button Content="Supprimer" Width="80" Click="DeleteLayer_Click" Margin="5,0"/>
            <Button Content="Fermer" Width="80" Click="Close_Click" Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>