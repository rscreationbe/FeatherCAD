<Window x:Class="FeatherCAD.Controls.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FeatherCAD.Controls"
        Title="Couleur du tracé" Width="200" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="10">
        <TextBlock Text="Sélectionnez une couleur :" Margin="0,0,0,10" FontWeight="Bold"/>

        <!-- Grille de couleurs -->
        <UniformGrid Columns="4" x:Name="ColorGrid">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Height" Value="30"/>
                    <EventSetter Event="Click" Handler="ColorButton_Click"/>
                </Style>
            </UniformGrid.Resources>

            <Button Background="Black" Tag="Black"/>
            <Button Background="Red" Tag="Red"/>
            <Button Background="Blue" Tag="Blue"/>
            <Button Background="Green" Tag="Green"/>
            <Button Background="Orange" Tag="Orange"/>
            <Button Background="Magenta" Tag="Magenta"/>
            <Button Background="Cyan" Tag="Cyan"/>
            <Button Background="Gray" Tag="Gray"/>
        </UniformGrid>

        <Button Content="Annuler" Click="Cancel_Click" Margin="0,10,0,10" Height="30"/>
    </StackPanel>
</Window>
