<UserControl x:Class="FeatherCAD.Controls.FlyoutButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <!-- BOUTON PRINCIPAL -->
        <ToggleButton x:Name="MainBtn" 
                Width="40" Height="40" Margin="1"
                PreviewMouseDown="MainBtn_PreviewMouseDown"
                PreviewMouseUp="MainBtn_PreviewMouseUp">
            <Image Source="{Binding MainIcon, ElementName=Root}" />
        </ToggleButton>

        <!-- MENU DÉPLIANT (POPUP) -->
        <Popup x:Name="SubMenuPopup" Placement="Right" 
               PlacementTarget="{Binding ElementName=MainBtn}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" Padding="0">
                <ItemsControl ItemsSource="{Binding SubItems, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="38" Height="38"
                                    Tag="{Binding Tag}" ToolTip="{Binding ToolTip}"
                                    Click="SubItem_Click">
                                <Image Source="{Binding Icon}" Margin="1"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
