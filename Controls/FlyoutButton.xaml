<UserControl x:Class="FeatherCAD.Controls.FlyoutButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FeatherCAD.Controls"
             x:Name="Root">
    <Grid>
        <!-- Bouton Principal -->
        <ToggleButton x:Name="MainBtn" Width="40" Height="40" Padding="0"
                      PreviewMouseDown="MainBtn_PreviewMouseDown" 
                      PreviewMouseUp="MainBtn_PreviewMouseUp"
                      IsChecked="{Binding IsOpen, ElementName=SubMenuPopup, Mode=OneWay}">
            <Grid>
                <Image Source="{Binding MainIcon, ElementName=Root}" Margin="5"/>
                <!-- Indicateur visuel (petite flèche) -->
                <Path Data="M 0 0 L 3 3 L 6 0 Z" Fill="#888" VerticalAlignment="Bottom" 
                      HorizontalAlignment="Right" Margin="2" Stretch="Uniform" Width="5"/>
            </Grid>
        </ToggleButton>

        <!-- Menu Horizontal -->
        <Popup x:Name="SubMenuPopup" Placement="Right" StaysOpen="False" 
               AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="2">
            <Border Background="#F0F0F0" BorderBrush="Gray" BorderThickness="1" CornerRadius="2">
                <ItemsControl ItemsSource="{Binding SubItems, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="SubItem_Click" Width="40" Height="40" Margin="1" 
                                    Background="Transparent" BorderThickness="0">
                                <Image Source="{Binding Icon}" Margin="1"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>